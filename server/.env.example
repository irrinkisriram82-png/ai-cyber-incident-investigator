# Copy to server/.env and fill in. NEVER commit server/.env.
NODE_ENV=development
PORT=5000

# MongoDB (local or Atlas). Required.
MONGODB_URI=mongodb://127.0.0.1:27017/cyber-incident-investigator

# Allowed browser origin(s) for CORS. Comma-separated for several.
CLIENT_URL=http://localhost:5173

# Google Gemini (optional: without a key the app uses curated demo cases)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=20000
AI_FALLBACK_ENABLED=true

# HTTP hardening
REQUEST_BODY_LIMIT=10kb
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_GENERATE_MAX=10
RATE_LIMIT_MUTATION_MAX=60
RATE_LIMIT_GLOBAL_MAX=300

# Set to 1 when deployed behind a reverse proxy / PaaS (Render, Railway, ...)
TRUST_PROXY=0
